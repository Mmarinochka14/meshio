# Django application settings
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL database
POSTGRES_DB=meshio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Cloud.ru object storage
CLOUDRU_ACCESS_KEY_ID=your-cloudru-access-key-id
CLOUDRU_SECRET_ACCESS_KEY=your-cloudru-secret-access-key
CLOUDRU_STORAGE_ENDPOINT=https://s3.cloud.ru
CLOUDRU_STORAGE_REGION=ru-central-1
CLOUDRU_STORAGE_BUCKET=meshio-media

# Third-party integrations
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

UNISENDER_API_KEY=
UNISENDER_LIST_ID=
UNISENDER_BASE_URL=https://api.unisender.com/ru/api

# Frontend URL for CORS and API
FRONTEND_URL=http://localhost:5173

# Email settings
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Meshio <noreply@meshio.local>
